<?xml version="1.0" encoding="utf-8"?>
<!-- Подписки и HWID не уходят ни в облачную копию, ни на другое устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
