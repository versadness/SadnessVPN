{
  "name": "sadness-vpn",
  "productName": "Sadness VPN",
  "version": "3.4.2",
  "description": "Sadness Private Network — desktop client",
  "main": "electron/main.js",
  "author": "Sadness",
  "homepage": "https://github.com/versadness/SadnessVPN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack:runtime": "electron-builder --win --x64 --dir",
    "pack:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sadness.vpn",
    "productName": "Sadness VPN",
    "directories": {
      "output": "dist/electron-runtime",
      "buildResources": "."
    },
    "afterPack": "tools/electron-afterpack.js",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/*/**",
      "node_modules/koffi/build/koffi/win32_x64/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/src/**"
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "app.ico",
        "to": "app.ico"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app.png",
      "category": "Network",
      "executableName": "sadness-vpn",
      "artifactName": "SadnessVPN-${version}-linux-${arch}.${ext}",
      "synopsis": "Sadness Private Network — VPN-клиент",
      "description": "VPN-клиент с подписками, TUN, маршрутизацией приложений и резервными серверами",
      "maintainer": "Sadness <versadness@users.noreply.github.com>",
      "desktop": {
        "Name": "Sadness VPN",
        "Comment": "Sadness Private Network",
        "StartupWMClass": "Sadness VPN"
      },
      "extraResources": [
        {
          "from": "dist/linux-runtime/SadnessVPN",
          "to": "runtime"
        },
        {
          "from": "app.png",
          "to": "app.png"
        }
      ]
    },
    "deb": {
      "afterInstall": "installer/linux/after-install.sh",
      "depends": [
        "libcap2-bin"
      ]
    },
    "rpm": {
      "afterInstall": "installer/linux/after-install.sh",
      "depends": [
        "libcap"
      ]
    },
    "pacman": {
      "afterInstall": "installer/linux/after-install.sh",
      "depends": [
        "libcap"
      ]
    },
    "appImage": {
      "artifactName": "SadnessVPN-${version}-linux-${arch}.AppImage"
    }
  }
}
